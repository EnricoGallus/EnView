<div class="drawer">
  <input id="enchan-navbar" type="checkbox" class="drawer-toggle"/>
  <div class="drawer-content flex flex-col">
    <div class="navbar bg-base-300 w-full uppercase h-16">
      <div class="flex-none lg:hidden">
        <label for="enchan-navbar" aria-label="open sidebar" class="btn btn-square btn-ghost">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            class="inline-block h-6 w-6 stroke-current"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            ></path>
          </svg>
        </label>
      </div>
      <div class="navbar-start">
        <%= nav_start %>
      </div>
      <div class="hidden lg:block navbar-center">
        <ul class="menu menu-horizontal join">
          <%= render(UI::Nav::MenuComponent.with_collection(menu_items)) %>
        </ul>
      </div>
      <div class="navbar-end">
        <%= nav_end %>
      </div>
    </div>
    <main>
      <%= content %>
    </main>
  </div>
  <div class="drawer-side">
    <label for="enchan-navbar" aria-label="close sidebar" class="drawer-overlay"></label>
    <ul class="menu bg-base-200 min-h-full w-80 p-4">
      <%= render(UI::Nav::MenuComponent.with_collection(menu_items)) %>
    </ul>
  </div>
</div>